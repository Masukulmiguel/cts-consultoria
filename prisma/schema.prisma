datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  locale    String    @default("pt")
  ipHash    String?   // hash SHA-256 do IP (privacy-preserving rate limit/antispam)
  userAgent String?
  handledAt DateTime?
  handledBy User?      @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledById String?
  createdAt DateTime  @default(now())
  read      Boolean   @default(false)

  @@index([createdAt])
  @@index([read, createdAt])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          UserRole @default(ADMIN)
  locale        String   @default("pt")
  totpSecretEnc String?
  totpEnabled   Boolean  @default(false)
  sessionVersion Int     @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  handledMessages ContactMessage[]

  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CONTENT
  INSTRUCTOR
  SUPPORT
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  ip         String?   // IP do request para auditoria
  userAgent  String?   // User-Agent do request para auditoria
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
