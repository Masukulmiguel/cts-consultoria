datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  locale    String    @default("pt")
  ipHash    String?   // hash SHA-256 do IP (privacy-preserving rate limit/antispam)
  userAgent String?
  handledAt DateTime?
  handledBy User?      @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledById String?
  createdAt DateTime  @default(now())
  read      Boolean   @default(false)

  @@index([createdAt])
  @@index([read, createdAt])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          UserRole @default(ADMIN)
  locale        String   @default("pt")
  totpSecretEnc String?
  totpEnabled   Boolean  @default(false)
  sessionVersion Int     @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  handledMessages ContactMessage[]

  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CONTENT
  INSTRUCTOR
  SUPPORT
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  ip         String?   // IP do request para auditoria
  userAgent  String?   // User-Agent do request para auditoria
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Serviço de consultoria publicado no website (CRUD no admin).
model Service {
  id          String   @id @default(cuid())
  slugPt      String   @unique
  slugEn      String   @unique
  titlePt     String
  titleEn     String
  categoryPt  String
  categoryEn  String
  summaryPt   String
  summaryEn   String
  bulletsPt   String[] @default([])
  bulletsEn   String[] @default([])
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// Curso da CTS Academia (CRUD no admin).
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  family      String
  summary     String
  summaryEn   String?
  level       String?
  duration    String?
  price       String?
  brochureUrl String?
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// Notícia ou artigo (CRUD no admin).
model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  excerpt     String
  excerptEn   String?
  body        String
  bodyEn      String?
  category    String?
  imageUrl    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

/// Pergunta frequente (CRUD no admin).
model Faq {
  id        String   @id @default(cuid())
  question  String
  questionEn String?
  answer    String
  answerEn  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}
