# ---------------------------------------------------------------
# CTS Consultoria — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------

# Base de dados (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cts?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# MFA (TOTP) — nome emitente mostrado nas apps autenticadoras
TOTP_ISSUER="CTS Consultoria"

# Seed do superadministrador (apenas na primeira instalação; REMOVER em produção)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Seed do formando de demonstração (opcional; remover em produção)
SEED_STUDENT_EMAIL=""
SEED_STUDENT_PASSWORD=""

# Armazenamento de ficheiros privados (S3-compatível; fase 7)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Email transaccional SMTP (fase 5+)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM=""

# Integração AngoAPI — DESLIGADA por omissão (docs/03)
ANGOAPI_ENABLED="false"
# ANGOAPI_BASE_URL=""
# ANGOAPI_TOKEN=""
