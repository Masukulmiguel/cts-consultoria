{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignore": [".next/**", "node_modules/**", "next-env.d.ts", "prisma/*.sql"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } } },
      "security": { "noDangerouslySetInnerHtml": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } }
}
